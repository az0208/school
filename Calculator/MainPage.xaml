<Page
    x:Class="Calculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="HotPink">

    <Grid x:Name="MainGrid" Background="DeepPink" Margin="100" CornerRadius="200" >
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="almog's calculator" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="7" FontSize="78" Grid.RowSpan="4" FontFamily="Berlin Sans FB Demi" TextAlignment="Center" FontStyle="Normal"></TextBlock>
        <Button x:Name="digit1" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="1" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit1_Click"></Button>
        <Button x:Name="digit2" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="2" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit2_Click" ></Button>
        <Button x:Name="digit3" Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="3" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit3_Click" ></Button>
        <Button x:Name="digit4" Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="4" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit4_Click" ></Button>
        <Button x:Name="digit5" Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="5" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit5_Click" ></Button>
        <Button x:Name="digit6" Grid.Row="4" Grid.Column="7" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="6" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit6_Click" ></Button>
        <Button x:Name="digit7" Grid.Row="4" Grid.Column="8" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="7" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit7_Click" ></Button>
        <Button x:Name="digit8" Grid.Row="4" Grid.Column="9" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="8" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit8_Click" ></Button>
        <Button x:Name="digit9" Grid.Row="4" Grid.Column="10" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="9" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit9_Click" ></Button>
        <Button x:Name="digit0" Grid.Row="4" Grid.Column="11" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="0" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="digit0_Click" ></Button>
        <Button x:Name="signplus" Grid.Row="8" Grid.Column="5" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="+" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signplus_Click" ></Button>
        <Button x:Name="signminus" Grid.Row="8" Grid.Column="6" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="-" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signminus_Click" ></Button>
        <Button x:Name="signmulti" Grid.Row="8" Grid.Column="7" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="X" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signmulti_Click" ></Button>
        <Button x:Name="signdivide" Grid.Row="8" Grid.Column="8" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="/" FontSize="60" BorderBrush="LightPink" BorderThickness="5"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signdivide_Click" ></Button>
        <Button x:Name="signC" Grid.Row="8" Grid.Column="4" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="C" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signC_Click" ></Button>
        <Button x:Name="signequals" Grid.Row="8" Grid.Column="11" Grid.ColumnSpan="2" Grid.RowSpan="3" Content="=" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signequals_Click" ></Button>
        <Button x:Name="signdot" Grid.Row="4" Grid.Column="12" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="." FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signdot_Click" ></Button>
        <Button x:Name="signDEL" Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="3" Content="DEL" FontSize="35" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signDEL_Click" ></Button>
        <Button x:Name="signtut" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1" Grid.RowSpan="3" Content="?" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signtut_Click" ></Button>
        <Button x:Name="signsuprise" Grid.Row="0" Grid.Column="12" Grid.ColumnSpan="1" Grid.RowSpan="3" Content=":)" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signsuprise_Click" ></Button>
        <Button x:Name="signanswer" Grid.Row="8" Grid.Column="9" Grid.ColumnSpan="2" Grid.RowSpan="3" Content="ANS" FontSize="60" BorderBrush="LightPink" BorderThickness="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="signanswer_Click" ></Button>
        <Border Grid.Row="12" Grid.Column="2" Grid.ColumnSpan="3" Grid.RowSpan="3" BorderBrush="LightPink" BorderThickness="10">
            <TextBlock x:Name="FirstNumberTXT" FontSize="45" TextAlignment="Center" ></TextBlock></Border>
        <Border Grid.Row="12" Grid.Column="5" Grid.ColumnSpan="1" Grid.RowSpan="3" BorderBrush="LightPink" BorderThickness="10">
            <TextBlock x:Name="OperatorTXT" FontSize="45" TextAlignment="Center" ></TextBlock>
        </Border>
        <Border Grid.Row="12" Grid.Column="6" Grid.ColumnSpan="3" Grid.RowSpan="3" BorderBrush="LightPink" BorderThickness="10">
            <TextBlock x:Name="SecondNumberTXT" FontSize="45" TextAlignment="Center" ></TextBlock>
        </Border>
        <Border Grid.Row="12" Grid.Column="9" Grid.ColumnSpan="1" Grid.RowSpan="3">
            <TextBlock Text="=" FontSize="45" TextAlignment="Center" ></TextBlock>
        </Border>
        <Border Grid.Row="12" Grid.Column="10" Grid.ColumnSpan="3" Grid.RowSpan="3" BorderBrush="LightPink" BorderThickness="10">
            <TextBlock x:Name="AnswerTXT" FontSize="45" TextAlignment="Center" ></TextBlock>
        </Border>
    </Grid>
</Page>